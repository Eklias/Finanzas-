# 1. API DE GROQ (Transcripción ultra-rápida de audio por voz con Whisper y fallback de modelos)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_DIAGNOSTICS=1

# 2. API DE DEEPSEEK (Motor pensante especializado en razonamiento contable para resolver el caso)
# Si configuras esta clave, DeepSeek resolverá y estructurará los casos contables.
# Obtén tu clave en: https://platform.deepseek.com/
DEEPSEEK_API_KEY=
